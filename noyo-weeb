    ./searchName "$ani_name"

    sleep 4
    readThing="$(ydotool mousemove -a -x 675 -y 39; grim -g "1172,115 364x55" - |\
     tesseract stdin stdout -l eng 2>/dev/null |\
     sed -n '1p')"

    focus_term
    case "${readThing,,}" in
        "no results found")
            echo "|⛌| That looks like it's not there! Nothing to do!"
            exit 1
            ;;
        "${ani_name,,}")
            echo "|✓| Name matches exactly to the search result! Continuing"
            sleep 1
            key_press "" "DOWN"
            key_press "" "RETURN"
            ;;
        "")
            echo "|⛌| Searching error! Try again!"
            exit 1
            ;;
        *)
            echo -n "|🤔| Name was found as $readThing. Continue? (y/n): "
            read -r ani_name_unsure

            case "${ani_name_unsure,,}" in
                "y")
                    key_press "" "DOWN"
                    key_press "" "RETURN" 
                ;;
                "n")
                    echo "Exiting..."
                    exit 0
                ;;
                *)
                    echo "Invalid statement! Exiting..."
                    exit 1
            esac
    esac
    focus_ffox
}


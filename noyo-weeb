measure_latency() {
    local total=0
    local count=5

    echo "|...| Measuring latency..."
    for ((check=0; check<$count; check++)); do
        latency=$(curl -o /dev/null -s -w '%{time_total}' https://animepahe.pw)
        total=$(awk "BEGIN {print $total + $latency}")
    done

    latency=$(awk "BEGIN {print $total / $count}")
    sleep=$(echo "$latency * 3"|bc)
    sleep=$(printf '%.5f\n' "$sleep")
    echo "|✓| Measured avarage latency with 5 pings as: $sleep"
}

latency() {
    [[ -z $sleep_time || $sleep_time -lt 1 ]] && {
        echo "|🤔| Sleep time not given, will be set using avarage latency calculation."
        measure_latency
    } || {
        echo "setting sleep time as given $sleep_time"
        sleep="$sleep_time"
    }
}

pfzf() {
    printf '%s\n' $@ |
        fzf \
            --style=full:rounded \
            --height='~-1' \
            --margin='1,10,10' \
            --padding=1 \
            --border=rounded \
            --border-label="$label" \
            --prompt='> ' \
            --info=inline-right:'😘 ' \
            --info-command='echo hi' \
            --preview="echo $prev" \
            --preview-window='right,25'
}

info() {
    echo -n "Name of the anime (press 'END' if you search it yourself):"
    read -rn3 ani_name
    if [[ "$ani_name" == $'\e[F' || -z "$ani_name" ]]; then
        :
    else
        read -r rest
        ani_name+="$rest"
    fi
    echo -e ""
    case "$ani_name" in
        $'\e[F')
            echo "|✓| Skipping automated searching for the anime!"
            ani_search_skip=true
            ;;
        "")
            echo "|⛌| ani_name cannot be blank! Enter a valid name!"
            exit 1
            ;;
        *)
            echo "|✓| name selected as '$ani_name'!"
    esac

    read -p "No of episodes: " ep_count

    [[ -z $ep_count || $ep_count -lt 1 ]] && {
        [[ -z $ep_count ]] && echo "|⛌| Enter the number of episodes, cannot be a zero"
        [[ $ep_count -lt 1 ]] && echo "|⛌| Enter a valid value. $ep_count cannot be a episode count!"
        exit 1
    }

    quality=$(label="Quality Selector"
                prev="{} quality will be used!"
                pfzf "360p" "720p" "1080p"
                )

    case $quality in
        "360p") quality=1; echo "Quality set: 360p" ;;
        "720p") quality=2; echo "Quality set: 720p" ;;
        "1080p") quality=3; echo "Quality set: 1080p" ;;
        *) echo -e "|⛌| No quality provided\nexiting..."; exit 1
    esac


    lang=$(label="Sub/Dub Selector"
            prev="{} will be downloaded!"
            pfzf "Sub" "Dub"
            )

    case $lang in
        "Sub") lang=1; echo "Language set: Sub" ;;
        "Dub") lang=2 ; echo "Language set: Dub" ;;
        *) echo -e "|⛌| No language option provided\nexiting..."; exit 1
    esac

    read -p "Want to download automatically too? I mean not just opening kwik tabs? (y/n): " down_verify
    down_verify=${down_verify,,}
    [[ -z $down_verify ]] && {
        echo "Invalid, cannot be null"
        exit 1
    } || {
        [[ $down_verify != "y" && $down_verify != "n" ]] && {
            echo "|⛌| Should be (Y/y)/(N/n)"
            exit 1
        }
    }

    read -p "Is dub available at animepahe? (go and check! else sub will be downloaded 😭)(y/n): " lang_avail
    lang_avail=${lang_avail,,}

    [[ -z $lang_avail ]] && {
        echo "Invalid, cannot be null"
        exit 1
    } || {
        [[ $lang_avail != "y" && $lang_avail != "n" ]] && {
            echo "|⛌| Should be (Y/y)/(N/n)"
            exit 1
        }
    }
}


a_move() {
    ydotool mousemove -a -x $1 -y $2 &>/dev/null
}

move() {
    ydotool mousemove -x $1 -y $2 &>/dev/null
}

click() {
    ydotool click 0xC0 2&>/dev/null
}

key_press() {
    hyprctl dispatch 'hl.dsp.send_shortcut({mods = "'"$1"'", key = "'"$2"'", window = "class:^(firefox)$"})'>/dev/null
}

press_tab() {
    for ((tab=0; tab<$1; tab++)); do
        key_press "" "TAB"
    done
}

layout_validation() {
    pgrep ydotoold --quiet && {
        echo "|✓| ydotool daemon is running" 
        } || {
        echo "|🤔| Ydotool isn't running..."
        echo "|✓| Initializing ydotoold..."
        ydotoold > /dev/null &
        sleep 1
    }
    pgrep firefox --quiet && {
        [[ "$ani_search_skip" == "true" ]] && {
            echo "|✓| firefox is running. Make sure it's fresh with no anyother tabs!"
        } || {
            echo "|✓| firefox is running. killing and restarting is fresh with no anyother tabs!"
            killall firefox 2&> /dev/null
            hyprctl dispatch 'hl.dsp.focus({ workspace = "'"$((term_workspace + 1))"'" })' 2&>/dev/null
            firefox "https://animepahe.pw" &
            key_press "CTRL" "R"
            sleep 2
            focus_term
        }
    } || {
        echo "|🤔| firefox isn't running!"
        echo "|✓| Opening it in another workspace as fresh!"
        sleep 1
        hyprctl dispatch 'hl.dsp.focus({ workspace = "'"$((term_workspace + 1))"'" })'
        firefox "https://animepahe.pw" &
        sleep 2
        key_press "CTRL" "R"
        focus_term 
    }
    [[ $(hyprctl getoption input:accel_profile -j | jq -r '.str') != "flat" ]] && {
        echo -e "|⛌| Hyprland mouse accel profile has to be flat\nSet your config as:\n\nhl.config({\n    input = {\n        accel_profile = \"flat\"\n    }\n}) "
        exit 1
    } || {
        echo "|✓| Hyprland cursor acceleration profile has set to flat."
    }
    echo "|✓| Setting valid firefox sizes and positions"
    hyprctl dispatch 'hl.dsp.window.float({ window = "class:^(firefox)$" })' > /dev/null
    hyprctl dispatch 'hl.dsp.window.resize({ window = "class:^(firefox)$", x = 1894, y = 1054 })' > /dev/null
    hyprctl dispatch 'hl.dsp.window.move({ window = "class:^(firefox)$", x = 13, y = 13 })' > /dev/null
    sleep 1
}

focus_ffox() {
    hyprctl dispatch 'hl.dsp.focus({ window = "class:^(firefox)$" })'>/dev/null
}

focus_term() {
    hyprctl dispatch 'hl.dsp.focus({ window = "pid:'"$pid"'"})'>/dev/null
}

